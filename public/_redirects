# Clean URL aliases for CF Pages.
# Status 200 = rewrite (URL stays clean), not 301 redirect.

# Home
/                       /pages/index.html             200

# Top-level page aliases
/bitcoin                /pages/bitcoin.html           200
/bitcoin.html           /pages/bitcoin.html           200
/pizza-day-2026         /pages/pizza-day-2026.html    200
/pizza-day-2026.html    /pages/pizza-day-2026.html    200
/meetup-june-2026       /pages/meetup-june-2026.html  200
/meetup-june-2026.html  /pages/meetup-june-2026.html  200
/meetup-august-2026      /pages/meetup-august-2026.html  200
/meetup-august-2026.html /pages/meetup-august-2026.html  200
/meetup-september-2026      /pages/meetup-september-2026.html  200
/meetup-september-2026.html /pages/meetup-september-2026.html  200
/events                 /pages/events.html            200
/events.html            /pages/events.html            200
/blog                   /pages/blog.html              200
/blog.html              /pages/blog.html              200

# Tina admin (Tina build writes /admin/index.html under dist/)
/admin                  /admin/index.html             200

# Language-prefixed URLs - share EN or VI directly; i18n.js reads the /en/ or /vi/ prefix.
/en                     /pages/index.html             200
/en/                    /pages/index.html             200
/vi                     /pages/index.html             200
/vi/                    /pages/index.html             200
/en/*                   /pages/:splat                 200
/vi/*                   /pages/:splat                 200

# Fallback for unknown paths -> homepage
/*                      /pages/index.html             200
